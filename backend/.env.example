# Copy this file to .env and fill in real values.
# .env is git-ignored — it will never be committed.

# App
ENVIRONMENT=development

# Security — generate a real random value for this, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-real-random-secret

# Database — SQLite is fine for quick local runs without Docker.
# docker-compose overrides this automatically to point at the Postgres
# container when you run `docker compose up`.
DATABASE_URL=sqlite:///./vigil_dev.db

# Will be used starting Month 1 onward
# LLM_API_KEY=
# VIRUSTOTAL_API_KEY=
# PHISHTANK_API_KEY=
# OPENPHISH_API_KEY=
